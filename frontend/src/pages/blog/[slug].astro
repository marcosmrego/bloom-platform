---
import { getPost, registerClick } from '../../lib/api';

const TENANT = 'viralbarato';
const { slug } = Astro.params;
const post = await getPost(TENANT, slug!);

if (!post) {
  return Astro.redirect('/404');
}

// Marcação com estrelas
const stars = post.rating ? '⭐'.repeat(Math.floor(post.rating)) + (post.rating % 1 >= 0.5 ? '½' : '') : '';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{post.title}</title>
  <meta name="description" content={post.excerpt || post.title} />
  <meta property="og:title" content={post.title} />
  <meta property="og:image" content={post.image_url || ''} />
  <style>
    :root { --accent: #e63946; --bg: #fff; --text: #212529; --muted: #6c757d; --green: #2d6a4f; --border: #dee2e6; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f8f9fa; color: var(--text); line-height: 1.8; }
    .container { max-width: 720px; margin: 0 auto; padding: 0 1rem; }
    header { background: var(--accent); color: #fff; padding: 1rem 0; margin-bottom: 2rem; }
    header a { color: #fff; text-decoration: none; }
    article { background: var(--bg); padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); margin-bottom: 2rem; }
    h1 { font-size: 1.8rem; margin-bottom: 1rem; line-height: 1.3; }
    .meta { display: flex; gap: 1rem; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .rating { font-size: 1.2rem; }
    .price { font-size: 1.4rem; font-weight: 700; color: var(--green); }
    .category { background: #f1f3f5; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; color: var(--muted); }
    .content { font-size: 1.05rem; }
    .content h2 { font-size: 1.3rem; margin: 1.5rem 0 0.5rem; }
    .content h3 { font-size: 1.15rem; margin: 1rem 0 0.5rem; }
    .content p { margin-bottom: 1rem; }
    .content ul, .content ol { margin-left: 1.5rem; margin-bottom: 1rem; }
    .content table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; }
    .content th, .content td { border: 1px solid var(--border); padding: 0.5rem; text-align: left; }
    .content th { background: #f8f9fa; font-weight: 600; }
    .content blockquote { border-left: 3px solid var(--accent); margin: 1rem 0; padding: 0.5rem 1rem; background: #fff5f5; font-style: italic; }
    .pros-cons { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.5rem 0; }
    .pros, .cons { padding: 1rem; border-radius: 8px; }
    .pros { background: #e8f5e9; }
    .cons { background: #fce4e4; }
    .pros h3 { color: var(--green); margin-top: 0; }
    .cons h3 { color: #c62828; margin-top: 0; }
    .buy-btn { display: block; width: 100%; max-width: 400px; margin: 2rem auto 0; padding: 1rem; background: #ff9900; color: #111 !important; text-align: center; text-decoration: none; border-radius: 8px; font-size: 1.15rem; font-weight: 700; transition: background 0.2s; }
    .buy-btn:hover { background: #e68a00; }
    .back-link { display: inline-block; margin: 1.5rem 0; color: var(--muted); font-size: 0.9rem; }
    footer { text-align: center; padding: 2rem; color: var(--muted); font-size: 0.85rem; }
    @media (max-width: 600px) { .pros-cons { grid-template-columns: 1fr; } article { padding: 1rem; } }
  </style>
</head>
<body>
  <header><div class="container"><a href="/">← ViralBarato</a> / <a href={`/categoria/${post.category_slug}`}>{post.category_name}</a></div></header>

  <main class="container">
    <article>
      <span class="category">{post.category_name || 'Review'}</span>
      <h1>{post.title}</h1>

      <div class="meta">
        {post.rating && <span class="rating">{stars} <strong>{post.rating}/5</strong></span>}
        {post.product_price && <span class="price">R$ {post.product_price.toFixed(2)}</span>}
        <span class="category">{new Date(post.published_at).toLocaleDateString('pt-BR')}</span>
      </div>

      {(post.tags?.length > 0) && (
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem">
          {post.tags.map((tag: string) => <span style="background:#e9ecef;padding:0.2rem 0.6rem;border-radius:12px;font-size:0.75rem;color:var(--muted)">{tag}</span>)}
        </div>
      )}

      <div class="content" set:html={post.content} />

      {(post.pros?.length > 0 || post.cons?.length > 0) && (
        <div class="pros-cons">
          {post.pros?.length > 0 && (
            <div class="pros">
              <h3>✅ Prós</h3>
              <ul>{post.pros.map((p: string) => <li>{p}</li>)}</ul>
            </div>
          )}
          {post.cons?.length > 0 && (
            <div class="cons">
              <h3>❌ Contras</h3>
              <ul>{post.cons.map((c: string) => <li>{c}</li>)}</ul>
            </div>
          )}
        </div>
      )}

      {post.affiliate_url && (
        <a href={post.affiliate_url} class="buy-btn" target="_blank" rel="nofollow sponsored">
          🛒 Comprar na Amazon por R$ {post.product_price?.toFixed(2) || '---'}
        </a>
      )}
    </article>

    <a href="/" class="back-link">← Voltar para home</a>
  </main>

  <footer>© 2026 ViralBarato — Links de afiliado Amazon</footer>
</body>
</html>
