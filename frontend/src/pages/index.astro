---
import { getPosts, getCategories } from '../lib/api';

const TENANT = 'viralbarato'; // TODO: detectar do domínio
const posts = await getPosts(TENANT);
const categories = await getCategories(TENANT);
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>ViralBarato — Reviews e Menores Preços</title>
  <meta name="description" content="Descubra produtos com melhor custo-benefício. Reviews reais e links diretos para comprar." />
  <style>
    :root { --accent: #e63946; --bg: #f8f9fa; --card: #fff; --text: #212529; --muted: #6c757d; --border: #dee2e6; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
    .container { max-width: 1000px; margin: 0 auto; padding: 0 1rem; }
    header { background: var(--accent); color: #fff; padding: 1.5rem 0; margin-bottom: 2rem; }
    header h1 { font-size: 1.8rem; }
    header p { opacity: 0.9; font-size: 1rem; margin-top: 0.25rem; }
    .cats { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
    .cats a { background: var(--card); border: 1px solid var(--border); padding: 0.5rem 1rem; border-radius: 20px; text-decoration: none; color: var(--text); font-size: 0.9rem; transition: all 0.2s; }
    .cats a:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
    .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 3rem; }
    .card { background: var(--card); border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); transition: transform 0.2s, box-shadow 0.2s; }
    .card:hover { transform: translateY(-3px); box-shadow: 0 6px 16px rgba(0,0,0,0.12); }
    .card img { width: 100%; height: 180px; object-fit: cover; background: #e9ecef; }
    .card-body { padding: 1rem; }
    .card-cat { display: inline-block; background: #f1f3f5; color: var(--muted); padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.75rem; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .card-title { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.25rem; line-height: 1.3; }
    .card-title a { color: var(--text); text-decoration: none; }
    .card-title a:hover { color: var(--accent); }
    .card-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem; }
    .card-price { font-weight: 700; color: #2d6a4f; font-size: 1.1rem; }
    .card-rating { color: #f4a261; font-size: 0.85rem; }
    .card-date { font-size: 0.75rem; color: var(--muted); margin-top: 0.5rem; }
    footer { text-align: center; padding: 2rem 0; color: var(--muted); font-size: 0.85rem; border-top: 1px solid var(--border); margin-top: 2rem; }
    @media (max-width: 600px) { .posts-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <h1>🔥 ViralBarato</h1>
      <p>Reviews honestas. Links diretos. Menor preço.</p>
    </div>
  </header>

  <main class="container">
    <nav class="cats">
      <a href="/">Todos</a>
      {categories.map(cat => (
        <a href={`/categoria/${cat.slug}`}>{cat.name}</a>
      ))}
    </nav>

    <div class="posts-grid">
      {posts.map(post => (
        <article class="card">
          <img src={post.image_url || 'https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?w=400'} alt={post.title} loading="lazy" />
          <div class="card-body">
            <span class="card-cat">{post.category_name || 'Geral'}</span>
            <h2 class="card-title">
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </h2>
            <div class="card-meta">
              {post.product_price && <span class="card-price">R$ {post.product_price.toFixed(2)}</span>}
              {post.rating && <span class="card-rating">{'⭐'.repeat(Math.floor(post.rating))} {post.rating}</span>}
            </div>
            <div class="card-date">{new Date(post.published_at).toLocaleDateString('pt-BR')}</div>
          </div>
        </article>
      ))}
    </div>
  </main>

  <footer>
    <div class="container">
      © 2026 ViralBarato. Links de afiliado Amazon.
    </div>
  </footer>
</body>
</html>
