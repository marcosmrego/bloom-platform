---
export const prerender = false;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>Métricas · Bloom</title>
    <style>
      :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #172033; background: #eef2f7; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      header { padding: 1.35rem clamp(1rem, 4vw, 3rem); background: linear-gradient(120deg, #172033, #263a67); color: white; display: flex; gap: 1.5rem; align-items: end; justify-content: space-between; flex-wrap: wrap; box-shadow: 0 8px 28px rgba(23, 32, 51, .18); }
      header h1 { margin: .2rem 0 0; font-size: 1.7rem; }
      header p { margin: 0; color: #aeb8cc; font-size: .85rem; text-transform: uppercase; letter-spacing: .08em; }
      header a { color: white; }
      .filters { display: flex; gap: .7rem; flex-wrap: wrap; }
      label { display: grid; gap: .3rem; font-size: .75rem; color: #cdd5e4; }
      select { min-width: 130px; padding: .6rem .75rem; border: 1px solid #47536a; border-radius: 8px; background: #242f45; color: white; }
      main { padding: 1.5rem clamp(1rem, 4vw, 3rem) 3rem; max-width: 1500px; margin: auto; }
      .cards { display: grid; grid-template-columns: repeat(7, minmax(140px, 1fr)); gap: 1rem; }
      .card, .panel { background: white; border: 1px solid #dfe4ed; border-radius: 16px; box-shadow: 0 8px 24px rgba(28, 39, 60, .06); }
      .card { padding: 1.1rem; }
      .card span { color: #6d7890; font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; }
      .card strong { display: block; margin-top: .35rem; font-size: 1.8rem; }
      .card small { color: #8b95a8; }
      .layout { display: grid; grid-template-columns: minmax(0, 3fr) minmax(230px, 1fr); gap: 1rem; margin-top: 1rem; }
      .panel { padding: 1rem; overflow: hidden; }
      .panel-head { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; }
      .panel h2 { font-size: 1rem; margin: 0; }
      .panel-meta { color: #768198; font-size: .78rem; }
      .table-wrap { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; font-size: .88rem; }
      th, td { padding: .75rem .65rem; border-bottom: 1px solid #edf0f5; text-align: left; }
      th { color: #667188; font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; }
      td.numeric, th.numeric { text-align: right; font-variant-numeric: tabular-nums; }
      .post-title { min-width: 280px; font-weight: 650; }
      .tenant { display: inline-block; padding: .2rem .5rem; border-radius: 999px; background: #edf2ff; color: #3451a4; font-size: .72rem; }
      .sources { list-style: none; padding: 0; margin: 0; }
      .sources li { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem 0; border-bottom: 1px solid #edf0f5; }
      .aside-section + .aside-section { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid #e5eaf2; }
      .path { min-width: 0; overflow-wrap: anywhere; }
      .empty { color: #768198; padding: 2rem; text-align: center; }
      .importer { margin-top: 1rem; }
      .importer form { display: grid; grid-template-columns: repeat(4, minmax(140px, 1fr)); gap: .75rem; align-items: end; }
      .importer label { color: #59657b; }
      .importer input, .importer select, .importer button { width: 100%; padding: .65rem .75rem; border: 1px solid #ccd4e1; border-radius: 8px; background: white; color: #172033; }
      .importer button { background: #172033; color: white; cursor: pointer; }
      .importer .full { grid-column: 1 / -1; }
      .hint { color: #6d7890; font-size: .82rem; }
      .alerts { margin-top: 1rem; }
      .alert-list { display: grid; gap: .65rem; }
      .alert { display: grid; grid-template-columns: auto 1fr; gap: .7rem; padding: .8rem; border: 1px solid #e4e8f0; border-left-width: 4px; border-radius: 9px; }
      .alert.high { border-left-color: #c73737; background: #fff7f7; }
      .alert.medium { border-left-color: #d58b16; background: #fffbf2; }
      .alert.low { border-left-color: #4d6fb3; background: #f7f9ff; }
      .alert-badge { font-size: .68rem; font-weight: 700; text-transform: uppercase; }
      .alert strong, .alert small { display: block; }
      .alert small { margin-top: .2rem; color: #667188; }
      .pager { display: flex; justify-content: space-between; align-items: center; gap: .8rem; margin-top: 1rem; padding-top: .85rem; border-top: 1px solid #edf0f5; }
      .pager-status { color: #667188; font-size: .78rem; font-variant-numeric: tabular-nums; }
      .pager-actions { display: flex; gap: .45rem; }
      .pager button { border: 1px solid #cfd7e5; border-radius: 8px; padding: .48rem .72rem; background: white; color: #263a67; font-weight: 650; cursor: pointer; }
      .pager button:hover:not(:disabled) { border-color: #6681bd; background: #f4f7ff; }
      .pager button:focus-visible { outline: 3px solid rgba(76, 111, 179, .28); outline-offset: 2px; }
      .pager button:disabled { cursor: not-allowed; opacity: .42; }
      .proposal-list { display: grid; gap: .8rem; }
      .proposal { padding: 1rem; border: 1px solid #e1e6ef; border-radius: 10px; display: grid; grid-template-columns: 1fr auto; gap: 1rem; }
      .proposal h3 { margin: 0 0 .35rem; font-size: .95rem; }
      .proposal p { margin: .25rem 0; color: #59657b; font-size: .85rem; }
      .proposal a { color: #3451a4; overflow-wrap: anywhere; }
      .proposal-actions { display: flex; gap: .5rem; align-items: center; }
      .proposal-actions button { border: 0; border-radius: 8px; padding: .6rem .8rem; cursor: pointer; color: white; background: #263a67; }
      .proposal-actions .reject { background: #9f3535; }
      @media (max-width: 900px) { .cards { grid-template-columns: repeat(2, 1fr); } .layout { grid-template-columns: 1fr; } }
      @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } .pager { align-items: flex-start; flex-direction: column; } .pager-actions, .pager button { width: 100%; } }
    </style>
  </head>
  <body>
    <header>
      <div><p>Bloom · aquisição e conversão</p><h1>Painel de métricas</h1></div>
      <div class="filters">
        <label>Tenant<select id="tenant"><option value="">Todos</option><option value="viralbarato">ViralBarato</option><option value="mundonoprato">Mundo no Prato</option></select></label>
        <label>Período<select id="days"><option value="7">7 dias</option><option value="30" selected>30 dias</option><option value="90">90 dias</option></select></label>
        <a href="/admin/review">Revisão editorial</a>
      </div>
    </header>
    <main>
      <section class="cards">
        <article class="card"><span>Artigos publicados</span><strong id="posts">—</strong></article>
        <article class="card"><span>Visitas no site</span><strong id="views">—</strong><small id="view-breakdown">— em artigos</small></article>
        <article class="card"><span>Cliques afiliados</span><strong id="clicks">—</strong></article>
        <article class="card"><span>CTR afiliado</span><strong id="ctr">—</strong></article>
        <article class="card"><span>Receita</span><strong id="revenue">—</strong><small id="finance-status">aguardando importação</small></article>
        <article class="card"><span>Custos</span><strong id="cost">—</strong></article>
        <article class="card"><span>Resultado</span><strong id="result">—</strong></article>
      </section>
      <section class="panel alerts">
        <div class="panel-head"><h2>Alertas e ações recomendadas <span id="alert-count" class="tenant">0</span></h2><span class="panel-meta">Ordenados por prioridade</span></div>
        <div id="alert-list" class="alert-list"></div>
        <nav id="alert-pager" class="pager" aria-label="Paginação dos alertas">
          <span id="alert-page-status" class="pager-status" aria-live="polite"></span>
          <div class="pager-actions"><button type="button" data-page="alert" data-direction="previous">Anterior</button><button type="button" data-page="alert" data-direction="next">Próxima</button></div>
        </nav>
      </section>
      <section class="panel alerts">
        <h2>Propostas de monetização do Hermes <span id="proposal-count" class="tenant">0</span></h2>
        <p class="hint">O agente apenas propõe. Aprovar aplica o destino ao artigo publicado e registra sua decisão.</p>
        <div id="proposal-list" class="proposal-list"></div>
      </section>
      <section class="panel importer">
        <h2>Importar receita ou custo</h2>
        <form id="financial-form">
          <label>Tenant<select name="tenant_slug" required><option value="viralbarato">ViralBarato</option><option value="mundonoprato">Mundo no Prato</option></select></label>
          <label>Fonte<select name="provider" required><option value="amazon">Amazon</option><option value="adsense">AdSense</option><option value="adcash">Adcash</option><option value="manual">Manual</option></select></label>
          <label>Tipo<select name="entry_type" required><option value="revenue">Receita</option><option value="cost">Custo</option></select></label>
          <label>Data<input name="occurred_on" type="date" required /></label>
          <label>Valor (BRL)<input name="amount" type="number" min="0" step="0.01" required /></label>
          <label>ID externo único<input name="external_id" maxlength="200" required placeholder="pedido, linha ou período" /></label>
          <label>Post ID (opcional)<input name="post_id" type="number" min="1" /></label>
          <label>Descrição<input name="description" maxlength="500" /></label>
          <div class="full"><button type="submit">Salvar lançamento</button></div>
          <p id="import-status" class="hint full">Use o identificador do relatório para que uma reimportação atualize o lançamento, sem duplicá-lo.</p>
        </form>
      </section>
      <section class="layout">
        <article class="panel"><div class="panel-head"><h2>Desempenho por artigo</h2><span class="panel-meta">Mais visitados primeiro</span></div><div class="table-wrap"><table><thead><tr><th>Artigo</th><th>Tenant</th><th class="numeric">Visitas</th><th class="numeric">Cliques</th><th class="numeric">CTR</th><th class="numeric">Receita</th><th class="numeric">Resultado</th></tr></thead><tbody id="rows"></tbody></table></div><div id="empty" class="empty" hidden>Nenhum artigo encontrado.</div><nav id="article-pager" class="pager" aria-label="Paginação do desempenho por artigo"><span id="article-page-status" class="pager-status" aria-live="polite"></span><div class="pager-actions"><button type="button" data-page="article" data-direction="previous">Anterior</button><button type="button" data-page="article" data-direction="next">Próxima</button></div></nav></article>
        <aside class="panel"><div class="aside-section"><h2>Páginas mais acessadas</h2><ul id="pages" class="sources"></ul></div><div class="aside-section"><h2>Principais origens</h2><ul id="sources" class="sources"></ul></div></aside>
      </section>
    </main>
    <script>
      const tenant = document.querySelector('#tenant');
      const days = document.querySelector('#days');
      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);
      const number = new Intl.NumberFormat('pt-BR');
      const money = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
      const pageSize = { alert: 8, article: 10 };
      const currentPage = { alert: 1, article: 1 };
      let metricData = { alerts: [], posts: [] };
      const pageSlice = (items, type) => items.slice((currentPage[type] - 1) * pageSize[type], currentPage[type] * pageSize[type]);
      function updatePager(type, total) {
        const totalPages = Math.max(1, Math.ceil(total / pageSize[type]));
        currentPage[type] = Math.min(currentPage[type], totalPages);
        const start = total ? (currentPage[type] - 1) * pageSize[type] + 1 : 0;
        const end = Math.min(currentPage[type] * pageSize[type], total);
        document.querySelector(`#${type}-page-status`).textContent = total
          ? `${number.format(start)}–${number.format(end)} de ${number.format(total)} · página ${currentPage[type]} de ${totalPages}`
          : 'Nenhum item';
        const pager = document.querySelector(`#${type}-pager`);
        pager.querySelector('[data-direction="previous"]').disabled = currentPage[type] <= 1;
        pager.querySelector('[data-direction="next"]').disabled = currentPage[type] >= totalPages;
        pager.hidden = total <= pageSize[type];
      }
      function renderAlerts() {
        document.querySelector('#alert-list').innerHTML = metricData.alerts.length
          ? pageSlice(metricData.alerts, 'alert').map((item) => `<article class="alert ${escapeHtml(item.priority)}"><span class="alert-badge">${item.priority === 'high' ? 'Alta' : item.priority === 'medium' ? 'Média' : 'Baixa'}</span><div><strong>${escapeHtml(item.title)} · ${escapeHtml(item.post_title)}</strong><small>${escapeHtml(item.action)}</small></div></article>`).join('')
          : '<div class="empty">Nenhuma ação necessária com os dados atuais.</div>';
        updatePager('alert', metricData.alerts.length);
      }
      function renderArticles() {
        document.querySelector('#rows').innerHTML = pageSlice(metricData.posts, 'article').map((post) => `<tr><td class="post-title">${escapeHtml(post.title)}</td><td><span class="tenant">${escapeHtml(post.tenant_name)}</span></td><td class="numeric">${number.format(post.views)}</td><td class="numeric">${number.format(post.clicks)}</td><td class="numeric">${Number(post.ctr).toLocaleString('pt-BR')}%</td><td class="numeric">${money.format(Number(post.revenue))}</td><td class="numeric">${money.format(Number(post.result))}</td></tr>`).join('');
        document.querySelector('#empty').hidden = metricData.posts.length > 0;
        updatePager('article', metricData.posts.length);
      }
      async function loadProposals() {
        const query = new URLSearchParams({ status: 'pending' });
        if (tenant.value) query.set('tenant_slug', tenant.value);
        const response = await fetch(`/api/editorial/monetization/proposals?${query}`);
        if (!response.ok) throw new Error('Falha ao carregar propostas de monetização');
        const data = await response.json();
        document.querySelector('#proposal-count').textContent = number.format(data.count);
        document.querySelector('#proposal-list').innerHTML = data.items.length
          ? data.items.map((item) => `<article class="proposal"><div><h3>${escapeHtml(item.post_title)} <span class="tenant">${escapeHtml(item.tenant_name)}</span></h3><p><strong>${item.link_type === 'product' ? 'Produto específico' : item.link_type === 'search' ? 'Busca afiliada' : 'Sem correspondência'}</strong>${item.product_asin ? ` · ASIN ${escapeHtml(item.product_asin)}` : ''}${item.product_title ? ` · ${escapeHtml(item.product_title)}` : ''}</p><p>${escapeHtml(item.rationale)}</p>${item.destination_url ? `<a href="${escapeHtml(item.destination_url)}" target="_blank" rel="noopener noreferrer nofollow sponsored">Conferir destino ↗</a>` : ''}${Array.isArray(item.evidence) && item.evidence.length ? `<p><strong>Evidências:</strong> ${item.evidence.map((source) => `<a href="${escapeHtml(source.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(source.title)}</a>`).join(' · ')}</p>` : ''}</div><div class="proposal-actions"><button class="reject" data-proposal="${item.id}" data-decision="reject">Rejeitar</button><button data-proposal="${item.id}" data-decision="approve">Aprovar</button></div></article>`).join('')
          : '<div class="empty">Nenhuma proposta aguardando revisão.</div>';
      }
      async function decideProposal(id, decision) {
        const note = window.prompt(decision === 'approve' ? 'Nota da aprovação (opcional):' : 'Motivo da rejeição:') || '';
        const response = await fetch(`/api/editorial/monetization/proposals/${id}/decision`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ decision, reviewer: 'editor', note: note || null }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.detail || 'Falha ao registrar decisão');
        await Promise.all([load(), loadProposals()]);
      }
      async function load() {
        const query = new URLSearchParams({ days: days.value });
        if (tenant.value) query.set('tenant_slug', tenant.value);
        const response = await fetch(`/api/editorial/metrics?${query}`);
        if (!response.ok) throw new Error('Falha ao carregar métricas');
        const data = await response.json();
        document.querySelector('#posts').textContent = number.format(data.summary.published_posts);
        document.querySelector('#views').textContent = number.format(data.summary.views);
        document.querySelector('#view-breakdown').textContent = `${number.format(data.summary.article_views)} em artigos · ${number.format(data.summary.other_page_views)} em outras páginas`;
        document.querySelector('#clicks').textContent = number.format(data.summary.clicks);
        document.querySelector('#ctr').textContent = `${Number(data.summary.ctr).toLocaleString('pt-BR')}%`;
        document.querySelector('#revenue').textContent = money.format(Number(data.finance.revenue));
        document.querySelector('#cost').textContent = money.format(Number(data.finance.cost));
        document.querySelector('#result').textContent = money.format(Number(data.finance.result));
        document.querySelector('#finance-status').textContent = data.finance.status === 'available'
          ? `${money.format(Number(data.finance.unattributed_revenue))} sem atribuição a artigo`
          : 'aguardando importação';
        document.querySelector('#alert-count').textContent = number.format(data.alert_summary.total);
        metricData = { alerts: data.alerts, posts: data.posts };
        currentPage.alert = 1;
        currentPage.article = 1;
        renderAlerts();
        renderArticles();
        document.querySelector('#sources').innerHTML = data.sources.length
          ? data.sources.map((source) => `<li><span>${escapeHtml(source.source)}</span><strong>${number.format(source.views)}</strong></li>`).join('')
          : '<li class="empty">Dados de origem aparecerão após as primeiras visitas.</li>';
        document.querySelector('#pages').innerHTML = data.pages.length
          ? data.pages.slice(0, 10).map((page) => `<li><span class="path">${escapeHtml(page.path)} <small class="tenant">${escapeHtml(page.tenant_name)}</small></span><strong>${number.format(page.views)}</strong></li>`).join('')
          : '<li class="empty">As páginas mais acessadas aparecerão após novas visitas.</li>';
      }
      document.querySelector('#proposal-list').addEventListener('click', (event) => {
        const button = event.target.closest('button[data-proposal]');
        if (!button) return;
        decideProposal(Number(button.dataset.proposal), button.dataset.decision).catch((error) => alert(error.message));
      });
      document.querySelectorAll('.pager').forEach((pager) => pager.addEventListener('click', (event) => {
        const button = event.target.closest('button[data-page]');
        if (!button || button.disabled) return;
        const type = button.dataset.page;
        currentPage[type] += button.dataset.direction === 'next' ? 1 : -1;
        type === 'alert' ? renderAlerts() : renderArticles();
        pager.closest('.panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }));
      tenant.addEventListener('change', () => Promise.all([load(), loadProposals()]).catch(alert));
      days.addEventListener('change', () => load().catch(alert));
      const financialForm = document.querySelector('#financial-form');
      financialForm.querySelector('[name="occurred_on"]').value = new Date().toISOString().slice(0, 10);
      financialForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const values = Object.fromEntries(new FormData(financialForm));
        const status = document.querySelector('#import-status');
        const entry = {
          provider: values.provider,
          entry_type: values.entry_type,
          occurred_on: values.occurred_on,
          amount: Number(values.amount),
          currency: 'BRL',
          external_id: values.external_id,
          description: values.description || null,
          post_id: values.post_id ? Number(values.post_id) : null,
        };
        status.textContent = 'Salvando...';
        const response = await fetch('/api/editorial/revenue/import', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tenant_slug: values.tenant_slug, entries: [entry] }),
        });
        const result = await response.json();
        if (!response.ok) {
          status.textContent = result.detail || 'Falha ao importar lançamento.';
          return;
        }
        status.textContent = result.inserted ? 'Lançamento incluído.' : 'Lançamento existente atualizado.';
        financialForm.querySelector('[name="amount"]').value = '';
        financialForm.querySelector('[name="external_id"]').value = '';
        await load();
      });
      Promise.all([load(), loadProposals()]).catch((error) => alert(error.message));
    </script>
  </body>
</html>
