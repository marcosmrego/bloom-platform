---
export const prerender = false;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>Cadastrar produto · Bloom</title>
  </head>
  <body>
    <header class="topbar">
      <strong>Bloom · Produtos</strong>
      <a href="/admin/review">← Fila editorial</a>
    </header>

    <main>
      <h1>Cadastrar produto do Mercado Livre</h1>
      <p class="lead">O produto é conferido na API do Mercado Livre antes de ser salvo. O link de afiliado só é guardado se corresponder ao ID informado.</p>

      <form id="product-form">
        <label>Nome do produto
          <input name="name" required minlength="3" maxlength="200" placeholder="Chaleira elétrica 1,8L" />
        </label>
        <label>Link de afiliado
          <input name="affiliate_link" required type="url" maxlength="1000" placeholder="https://meli.la/..." />
        </label>
        <label>ID do produto (MLB)
          <input name="item_id" maxlength="20" placeholder="MLB24447228" />
          <small>Obrigatório quando o link meli.la não abre o produto direto.</small>
        </label>
        <button type="submit">Cadastrar produto</button>
      </form>

      <section id="result" hidden aria-live="polite">
        <h2 id="result-title"></h2>
        <p id="result-meta"></p>
        <img id="result-image" alt="" width="160" hidden />
        <button id="draft-button" type="button">Gerar draft</button>
      </section>
      <p id="error" role="alert" hidden></p>

      <section class="requests" aria-labelledby="requests-title">
        <h2 id="requests-title">Pedidos de draft</h2>
        <p class="hint">O Hermes busca os pedidos a cada poucos minutos. Quando o draft estiver pronto, ele aparece na <a href="/admin/review">fila editorial</a>.</p>
        <ul id="requests"></ul>
      </section>
    </main>

    <script>
      const form = document.querySelector<HTMLFormElement>('#product-form')!;
      const result = document.querySelector<HTMLElement>('#result')!;
      const resultTitle = document.querySelector<HTMLElement>('#result-title')!;
      const resultMeta = document.querySelector<HTMLElement>('#result-meta')!;
      const resultImage = document.querySelector<HTMLImageElement>('#result-image')!;
      const error = document.querySelector<HTMLElement>('#error')!;
      const submit = form.querySelector<HTMLButtonElement>('button')!;
      const draftButton = document.querySelector<HTMLButtonElement>('#draft-button')!;
      const requestList = document.querySelector<HTMLUListElement>('#requests')!;
      const POLL_MS = 15000;
      const statusLabels: Record<string, string> = {
        pending: 'Na fila',
        running: 'Hermes escrevendo',
        completed: 'Draft pronto',
        failed: 'Falhou',
      };
      let currentProductId: number | null = null;

      function showError(message: string) {
        error.textContent = message;
        error.hidden = false;
      }

      async function call(path: string, init?: RequestInit) {
        const response = await fetch(`/api/editorial/${path}`, {
          ...init,
          headers: { 'Content-Type': 'application/json' },
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(typeof body.detail === 'string' ? body.detail : 'Falha na operação.');
        }
        return body;
      }

      function renderRequests(items: any[]) {
        requestList.replaceChildren(
          ...items.map((item) => {
            const row = document.createElement('li');
            row.className = `status-${item.status}`;
            const title = document.createElement('strong');
            title.textContent = item.product_title;
            const badge = document.createElement('span');
            badge.textContent = statusLabels[item.status] || item.status;
            row.append(title, badge);
            if (item.status === 'failed' && item.error) {
              const reason = document.createElement('small');
              reason.textContent = item.error;
              row.append(reason);
            }
            return row;
          }),
        );
        if (!items.length) {
          const none = document.createElement('li');
          none.textContent = 'Nenhum pedido ainda.';
          requestList.append(none);
        }
      }

      async function loadRequests() {
        try {
          renderRequests((await call('products/draft-requests')).items);
          error.hidden = true;
        } catch (failure) {
          showError(failure instanceof Error ? failure.message : 'Falha ao carregar pedidos.');
        }
      }

      draftButton.addEventListener('click', async () => {
        if (currentProductId === null) return;
        draftButton.disabled = true;
        error.hidden = true;
        try {
          const queued = await call(`products/${currentProductId}/draft-request`, { method: 'POST' });
          draftButton.textContent = queued.created ? 'Pedido enviado ao Hermes' : 'Já havia um pedido ativo';
          await loadRequests();
        } catch (failure) {
          draftButton.disabled = false;
          showError(failure instanceof Error ? failure.message : 'Falha ao pedir o draft.');
        }
      });

      void loadRequests();
      window.setInterval(loadRequests, POLL_MS);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const payload: Record<string, string> = {
          name: String(data.get('name') || '').trim(),
          affiliate_link: String(data.get('affiliate_link') || '').trim(),
        };
        const itemId = String(data.get('item_id') || '').trim();
        if (itemId) payload.item_id = itemId;

        submit.disabled = true;
        error.hidden = true;
        result.hidden = true;
        try {
          const response = await fetch('/api/editorial/products/mercadolivre', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok) {
            const detail = typeof body.detail === 'string' ? body.detail : 'Não foi possível cadastrar o produto.';
            throw new Error(detail);
          }
          resultTitle.textContent = body.title;
          const price = body.price ? `R$ ${Number(body.price).toLocaleString('pt-BR', { minimumFractionDigits: 2 })}` : 'preço indisponível';
          resultMeta.textContent = `Cadastrado · ${body.external_id} · ${price} · produto #${body.product_id}`;
          resultImage.hidden = !body.image_url;
          if (body.image_url) resultImage.src = body.image_url;
          currentProductId = body.product_id;
          draftButton.disabled = false;
          draftButton.textContent = 'Gerar draft';
          result.hidden = false;
          form.reset();
        } catch (failure) {
          error.textContent = failure instanceof Error ? failure.message : 'Falha inesperada.';
          error.hidden = false;
        } finally {
          submit.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  body { margin: 0; color: #1f2a24; background: #f4f6f3; font-family: system-ui, sans-serif; }
  .topbar { display: flex; justify-content: space-between; align-items: center; padding: 16px 28px; color: #fff; background: #17382a; }
  .topbar a { color: #fff; }
  main { max-width: 560px; margin: 40px auto; padding: 0 20px; }
  h1 { margin: 0 0 8px; font-size: 1.5rem; }
  .lead { margin: 0 0 24px; color: #536057; line-height: 1.5; }
  form { display: grid; gap: 16px; padding: 24px; border: 1px solid #dde4df; border-radius: 12px; background: #fff; }
  label { display: grid; gap: 6px; font-weight: 600; font-size: .9rem; }
  label small { color: #7a857d; font-weight: 400; }
  input { padding: 10px 12px; border: 1px solid #c9d3cc; border-radius: 8px; font: inherit; }
  input:focus-visible, button:focus-visible { outline: 3px solid #b98a47; outline-offset: 2px; }
  button[type=submit] { padding: 12px; border: 0; border-radius: 8px; color: #fff; background: #17382a; font: inherit; font-weight: 700; cursor: pointer; }
  button[type=submit]:hover { background: #24543c; }
  button[type=submit]:disabled { opacity: .6; cursor: wait; }
  #result { margin-top: 24px; padding: 20px; border: 1px solid #b7d4c1; border-radius: 12px; background: #eef7f1; }
  #result h2 { margin: 0 0 6px; font-size: 1.1rem; }
  #result p { margin: 0 0 12px; color: #3d5546; }
  #draft-button { padding: 10px 16px; border: 0; border-radius: 8px; color: #fff; background: #b98a47; font: inherit; font-weight: 700; cursor: pointer; }
  #draft-button:disabled { opacity: .6; cursor: default; }
  .requests { margin-top: 36px; }
  .requests h2 { margin: 0 0 6px; font-size: 1.1rem; }
  .hint { margin: 0 0 12px; color: #536057; font-size: .9rem; }
  #requests { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  #requests li { display: flex; flex-wrap: wrap; gap: 6px 12px; justify-content: space-between; padding: 12px 14px; border: 1px solid #dde4df; border-radius: 10px; background: #fff; }
  #requests li span { font-size: .8rem; font-weight: 700; color: #536057; }
  #requests li.status-completed span { color: #1d6b3f; }
  #requests li.status-failed span { color: #8a2b22; }
  #requests li small { flex-basis: 100%; color: #8a2b22; }
  #error { margin-top: 24px; padding: 14px 16px; border: 1px solid #e3b4b0; border-radius: 10px; color: #8a2b22; background: #fbeceb; }
</style>
