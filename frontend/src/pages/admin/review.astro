---
export const prerender = false;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>Revisão editorial · Bloom</title>
  </head>
  <body>
    <header>
      <div>
        <span class="eyebrow">Bloom Platform</span>
        <h1>Revisão editorial</h1>
        <p>Edite e decida o destino dos drafts produzidos pelo Hermes.</p>
      </div>
      <div class="filters">
        <label>
          Tenant
          <select id="tenant">
            <option value="">Todos</option>
            <option value="viralbarato">ViralBarato</option>
            <option value="mundonoprato">Mundo no Prato</option>
          </select>
        </label>
        <label>
          Estado
          <select id="status">
            <option value="draft">Aguardando revisão</option>
            <option value="published">Publicados</option>
            <option value="archived">Rejeitados</option>
          </select>
        </label>
      </div>
    </header>

    <main>
      <aside>
        <div class="list-heading">
          <strong id="count">Carregando…</strong>
          <button id="refresh" class="quiet">Atualizar</button>
        </div>
        <div id="post-list" class="post-list" aria-live="polite"></div>
      </aside>

      <section id="empty" class="empty">
        <div>
          <span>✦</span>
          <h2>Selecione um draft</h2>
          <p>O conteúdo completo e o histórico aparecerão aqui.</p>
        </div>
      </section>

      <section id="editor" class="editor" hidden>
        <div class="editor-top">
          <div>
            <span id="tenant-label" class="tenant-label"></span>
            <h2 id="editor-heading">Editar draft</h2>
          </div>
          <span id="save-state" class="save-state"></span>
        </div>

        <form id="edit-form">
          <div class="grid two">
            <label class="wide">
              Título
              <input name="title" required maxlength="500" />
            </label>
            <label>
              Categoria
              <input name="category_slug" placeholder="slug-da-categoria" />
            </label>
            <label>
              ASIN do produto
              <input name="product_asin" placeholder="Opcional" />
            </label>
          </div>

          <label>
            Resumo
            <textarea name="excerpt" rows="3"></textarea>
          </label>

          <div class="content-grid">
            <label>
              Conteúdo Markdown
              <textarea name="content" rows="22" required></textarea>
            </label>
            <div>
              <span class="field-label">Prévia</span>
              <iframe id="preview" class="preview" sandbox="" title="Prévia segura do artigo"></iframe>
            </div>
          </div>

          <div class="grid two">
            <label>
              URL da imagem
              <input name="image_url" />
            </label>
            <label>
              Nota
              <input name="rating" type="number" min="0" max="5" step="0.1" />
            </label>
            <label>
              Título SEO
              <input name="seo_title" maxlength="500" />
            </label>
            <label>
              Descrição SEO
              <textarea name="seo_description" rows="2"></textarea>
            </label>
            <label>
              Tags
              <input name="tags" placeholder="tag 1, tag 2" />
            </label>
            <label>
              Prós
              <input name="pros" placeholder="Item 1, item 2" />
            </label>
            <label>
              Contras
              <input name="cons" placeholder="Item 1, item 2" />
            </label>
          </div>

          <div class="save-row">
            <button type="submit" class="secondary">Salvar alterações</button>
          </div>
        </form>

        <details open>
          <summary>Evidências e gates de qualidade</summary>
          <div id="quality-evidence" class="quality-evidence"></div>
        </details>

        <div id="decision-panel" class="decision-panel">
          <label>
            Responsável
            <input id="reviewer" value="editor" maxlength="100" />
          </label>
          <label class="decision-note">
            Nota da decisão
            <textarea id="decision-note" rows="2" placeholder="Opcional na aprovação; recomendada na rejeição"></textarea>
          </label>
          <div class="decision-actions">
            <button id="reject" class="danger">Rejeitar</button>
            <button id="approve" class="primary">Aprovar e publicar</button>
          </div>
        </div>

        <details>
          <summary>Histórico editorial</summary>
          <div id="history" class="history"></div>
        </details>
      </section>
    </main>

    <div id="toast" role="status" aria-live="polite"></div>

    <script>
      import { marked } from 'marked';

      const list = document.querySelector<HTMLDivElement>('#post-list')!;
      const count = document.querySelector<HTMLElement>('#count')!;
      const editor = document.querySelector<HTMLElement>('#editor')!;
      const empty = document.querySelector<HTMLElement>('#empty')!;
      const form = document.querySelector<HTMLFormElement>('#edit-form')!;
      const preview = document.querySelector<HTMLIFrameElement>('#preview')!;
      const history = document.querySelector<HTMLElement>('#history')!;
      const qualityEvidence = document.querySelector<HTMLElement>('#quality-evidence')!;
      const toast = document.querySelector<HTMLElement>('#toast')!;
      const statusFilter = document.querySelector<HTMLSelectElement>('#status')!;
      const tenantFilter = document.querySelector<HTMLSelectElement>('#tenant')!;
      const decisionPanel = document.querySelector<HTMLElement>('#decision-panel')!;
      let selectedId: number | null = null;

      const fields = [
        'title', 'excerpt', 'content', 'image_url', 'category_slug',
        'product_asin', 'rating', 'seo_title', 'seo_description',
      ];

      function notify(message: string, error = false) {
        toast.textContent = message;
        toast.className = error ? 'show error' : 'show';
        window.setTimeout(() => toast.className = '', 3500);
      }

      async function api(path: string, init?: RequestInit) {
        const response = await fetch(`/api/editorial/${path}`, {
          ...init,
          headers: { 'Content-Type': 'application/json', ...(init?.headers || {}) },
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.detail || 'Falha na operação');
        return body;
      }

      function splitList(value: FormDataEntryValue | null) {
        return String(value || '').split(',').map(item => item.trim()).filter(Boolean);
      }

      function escapeHtml(value: unknown) {
        return String(value ?? '')
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll("'", '&#039;');
      }

      function renderPreview() {
        const content = form.elements.namedItem('content') as HTMLTextAreaElement;
        const markdownWithoutRawHtml = escapeHtml(content.value || '');
        const rendered = marked.parse(markdownWithoutRawHtml) as string;
        preview.srcdoc = `<!doctype html>
          <html lang="pt-BR"><head>
          <meta charset="utf-8">
          <meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src https: data:; style-src 'unsafe-inline'">
          <style>body{font:16px/1.65 system-ui,sans-serif;color:#1d2922;padding:2px 14px}img{max-width:100%}pre{white-space:pre-wrap}a{color:#267047}</style>
          </head><body>${rendered}</body></html>`;
      }

      async function loadPosts() {
        list.innerHTML = '<p class="loading">Carregando drafts…</p>';
        const query = new URLSearchParams({ status: statusFilter.value, page_size: '100' });
        if (tenantFilter.value) query.set('tenant_slug', tenantFilter.value);
        try {
          const data = await api(`posts?${query}`);
          count.textContent = `${data.total} ${data.total === 1 ? 'item' : 'itens'}`;
          list.innerHTML = '';
          if (!data.items.length) {
            list.innerHTML = '<p class="loading">Nenhum item neste filtro.</p>';
            selectedId = null;
            editor.hidden = true;
            empty.hidden = false;
            return;
          }
          for (const post of data.items) {
            const button = document.createElement('button');
            button.className = `post-item${post.id === selectedId ? ' active' : ''}`;
            button.innerHTML = `
              <span>${post.tenant_name}</span>
              <strong></strong>
              <small>${new Date(post.updated_at || post.created_at).toLocaleString('pt-BR')}</small>
            `;
            button.querySelector('strong')!.textContent = post.title;
            button.addEventListener('click', () => openPost(post.id));
            list.append(button);
          }
        } catch (error) {
          list.innerHTML = '<p class="loading error-text">Não foi possível carregar.</p>';
          notify((error as Error).message, true);
        }
      }

      async function openPost(id: number) {
        try {
          const post = await api(`posts/${id}`);
          selectedId = id;
          (document.querySelector('#tenant-label') as HTMLElement).textContent = post.tenant_name;
          (document.querySelector('#editor-heading') as HTMLElement).textContent = post.title;
          for (const name of fields) {
            const input = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
            if (input) input.value = post[name] ?? '';
          }
          for (const name of ['tags', 'pros', 'cons']) {
            const input = form.elements.namedItem(name) as HTMLInputElement;
            input.value = Array.isArray(post[name]) ? post[name].join(', ') : '';
          }
          decisionPanel.hidden = post.status !== 'draft';
          const gates = post.quality_gates || {};
          const sources = Array.isArray(post.source_evidence) ? post.source_evidence : [];
          qualityEvidence.innerHTML = `
            <div class="gate-summary">
              <strong>${gates.sources_extracted ? '✓' : '✕'} Duas fontes extraídas</strong>
              <strong>${gates.primary_source_required
                ? (gates.primary_source_present ? '✓ Fonte primária presente' : '✕ Fonte primária ausente')
                : '— Fonte primária não exigida'}</strong>
            </div>
            ${sources.length ? sources.map((source: any) => `
              <article>
                <span>${escapeHtml(source.source_type)}</span>
                <a href="${escapeHtml(source.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(source.title)}</a>
                <small>Extraída em ${escapeHtml(source.extracted_at)}</small>
                <ul>${(source.evidence || []).map((item: unknown) => `<li>${escapeHtml(item)}</li>`).join('')}</ul>
              </article>
            `).join('') : '<p>Nenhuma evidência estruturada registrada.</p>'}
          `;
          history.innerHTML = post.reviews?.length
            ? post.reviews.map((item: any) => `
                <div><strong>${escapeHtml(item.action)}</strong> · ${escapeHtml(item.reviewer)}
                <small>${new Date(item.created_at).toLocaleString('pt-BR')}</small>
                ${item.note ? `<p>${escapeHtml(item.note)}</p>` : ''}</div>
              `).join('')
            : '<p>Nenhuma ação registrada.</p>';
          editor.hidden = false;
          empty.hidden = true;
          renderPreview();
          await loadPosts();
        } catch (error) {
          notify((error as Error).message, true);
        }
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!selectedId) return;
        const data = new FormData(form);
        const payload: Record<string, unknown> = {};
        for (const name of fields) {
          const value = String(data.get(name) || '').trim();
          payload[name] = name === 'rating' ? (value ? Number(value) : null) : (value || null);
        }
        payload.tags = splitList(data.get('tags'));
        payload.pros = splitList(data.get('pros'));
        payload.cons = splitList(data.get('cons'));
        try {
          await api(`posts/${selectedId}`, {
            method: 'PATCH',
            body: JSON.stringify(payload),
            headers: { 'X-Reviewer': (document.querySelector<HTMLInputElement>('#reviewer')!).value },
          });
          notify('Alterações salvas.');
          await openPost(selectedId);
        } catch (error) {
          notify((error as Error).message, true);
        }
      });

      async function decide(decision: 'approve' | 'reject') {
        if (!selectedId) return;
        const verb = decision === 'approve' ? 'publicar' : 'rejeitar';
        if (!window.confirm(`Confirma que deseja ${verb} este draft?`)) return;
        try {
          await api(`posts/${selectedId}/decision`, {
            method: 'POST',
            body: JSON.stringify({
              decision,
              reviewer: document.querySelector<HTMLInputElement>('#reviewer')!.value,
              note: document.querySelector<HTMLTextAreaElement>('#decision-note')!.value,
            }),
          });
          notify(decision === 'approve' ? 'Draft publicado.' : 'Draft rejeitado.');
          selectedId = null;
          editor.hidden = true;
          empty.hidden = false;
          await loadPosts();
        } catch (error) {
          notify((error as Error).message, true);
        }
      }

      form.elements.namedItem('content')!.addEventListener('input', renderPreview);
      document.querySelector('#approve')!.addEventListener('click', () => decide('approve'));
      document.querySelector('#reject')!.addEventListener('click', () => decide('reject'));
      document.querySelector('#refresh')!.addEventListener('click', loadPosts);
      statusFilter.addEventListener('change', loadPosts);
      tenantFilter.addEventListener('change', loadPosts);
      loadPosts();
    </script>
  </body>
</html>

<style>
  :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #18221d; background: #f2f5f2; }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; }
  header { min-height: 190px; padding: 34px 4vw; display: flex; align-items: end; justify-content: space-between; gap: 32px; color: #f9fff9; background: linear-gradient(130deg, #112a20, #24563c); }
  h1 { margin: 4px 0 6px; font: 700 clamp(2rem, 4vw, 3.5rem)/1.05 Georgia, serif; }
  header p { margin: 0; color: #c9dfd1; }
  .eyebrow, .tenant-label { color: #8fd0a9; font-size: .76rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .filters { display: flex; gap: 12px; padding: 14px; border: 1px solid #ffffff26; border-radius: 14px; background: #ffffff0c; }
  label { display: grid; gap: 7px; color: #445049; font-size: .78rem; font-weight: 700; }
  header label { color: #dce9e0; }
  input, textarea, select { width: 100%; border: 1px solid #ccd6cf; border-radius: 9px; padding: 10px 11px; color: #17251d; background: white; font: inherit; font-weight: 400; }
  textarea { resize: vertical; }
  input:focus, textarea:focus, select:focus { outline: 3px solid #5da87933; border-color: #43855e; }
  main { display: grid; grid-template-columns: minmax(260px, 330px) minmax(0, 1fr); gap: 22px; max-width: 1500px; margin: 0 auto; padding: 24px; }
  aside, .editor, .empty { min-height: 620px; border: 1px solid #dde4df; border-radius: 16px; background: white; box-shadow: 0 8px 30px #1d332511; }
  aside { overflow: hidden; }
  .list-heading, .editor-top, .save-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .list-heading { padding: 18px; border-bottom: 1px solid #e6ebe7; }
  button { border: 0; border-radius: 9px; padding: 10px 14px; cursor: pointer; font-weight: 800; }
  .quiet { color: #37634a; background: #e8f2eb; }
  .post-item { width: 100%; display: grid; gap: 6px; padding: 16px 18px; text-align: left; border-radius: 0; border-bottom: 1px solid #edf0ee; background: white; }
  .post-item:hover, .post-item.active { background: #f0f7f2; box-shadow: inset 3px 0 #3f8b5c; }
  .post-item span { color: #48805c; font-size: .7rem; font-weight: 800; text-transform: uppercase; }
  .post-item strong { line-height: 1.35; }
  .post-item small, .history small { color: #78827c; }
  .loading { padding: 22px; color: #6d7771; }
  .empty { display: grid; place-items: center; text-align: center; color: #718078; }
  .empty span { font-size: 2rem; color: #57966d; }
  .editor { padding: 24px; }
  .editor h2 { margin: 4px 0 0; font: 700 1.8rem Georgia, serif; }
  .save-state { color: #5d6b63; font-size: .8rem; }
  form { display: grid; gap: 18px; margin-top: 26px; }
  .grid { display: grid; gap: 15px; }
  .two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .wide { grid-column: 1 / -1; }
  .content-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .8fr); gap: 16px; }
  .field-label { display: block; margin-bottom: 7px; color: #445049; font-size: .78rem; font-weight: 700; }
  .preview { width: 100%; min-height: 520px; border: 1px solid #dde4df; border-radius: 10px; background: #fbfcfb; }
  .secondary { color: #28563b; background: #deeee3; }
  .primary { color: white; background: #247346; }
  .danger { color: #8b2828; background: #f7dfdf; }
  .decision-panel { display: grid; grid-template-columns: 180px 1fr auto; align-items: end; gap: 14px; margin-top: 24px; padding: 18px; border-radius: 12px; background: #f4f7f4; }
  .decision-actions { display: flex; gap: 8px; }
  details { margin-top: 20px; border-top: 1px solid #e1e6e2; padding-top: 15px; }
  summary { cursor: pointer; font-weight: 800; }
  .history > div { padding: 12px 0; border-bottom: 1px solid #edf0ee; }
  .history p { margin: 6px 0 0; }
  .quality-evidence { display: grid; gap: 12px; padding-top: 14px; }
  .gate-summary { display: flex; flex-wrap: wrap; gap: 8px; }
  .gate-summary strong { padding: 7px 10px; border-radius: 999px; color: #28563b; background: #e7f2ea; font-size: .78rem; }
  .quality-evidence article { display: grid; gap: 5px; padding: 12px; border: 1px solid #e1e8e3; border-radius: 10px; }
  .quality-evidence article span { color: #48805c; font-size: .7rem; font-weight: 800; text-transform: uppercase; }
  .quality-evidence article a { color: #276841; font-weight: 800; }
  .quality-evidence article small { color: #78827c; }
  .quality-evidence article ul { margin: 5px 0 0; padding-left: 20px; }
  #toast { position: fixed; right: 24px; bottom: 24px; transform: translateY(120px); padding: 13px 17px; border-radius: 10px; color: white; background: #245f3c; opacity: 0; transition: .2s; }
  #toast.show { transform: none; opacity: 1; }
  #toast.error { background: #8c3131; }
  .error-text { color: #982f2f; }
  @media (max-width: 900px) {
    header { align-items: start; flex-direction: column; }
    main { grid-template-columns: 1fr; }
    aside { min-height: auto; max-height: 330px; overflow: auto; }
    .content-grid, .decision-panel { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    main { padding: 12px; }
    .filters, .two { grid-template-columns: 1fr; display: grid; width: 100%; }
    .decision-actions { display: grid; }
  }
</style>
