---
export const prerender = false;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>Revisão editorial · Bloom</title>
  </head>
  <body>
    <header class="topbar">
      <div class="brand">
        <span class="brand-mark">B</span>
        <div><strong>Bloom</strong><span>Central editorial</span></div>
      </div>
      <div class="topbar-copy">
        <span class="eyebrow">Revisão humana</span>
        <h1>Fila editorial</h1>
      </div>
      <div class="filters">
        <label>Tenant
          <select id="tenant">
            <option value="">Todos</option>
            <option value="viralbarato">ViralBarato</option>
            <option value="mundonoprato">Mundo no Prato</option>
          </select>
        </label>
        <label>Estado
          <select id="status">
            <option value="draft">Aguardando revisão</option>
            <option value="published">Publicados</option>
            <option value="archived">Rejeitados</option>
          </select>
        </label>
      </div>
    </header>

    <main>
      <aside class="queue">
        <div class="queue-head">
          <div><span class="eyebrow">Sua caixa de entrada</span><strong id="count">Carregando…</strong></div>
          <button id="refresh" class="icon-button" title="Atualizar fila" aria-label="Atualizar fila">↻</button>
        </div>
        <div id="post-list" class="post-list" aria-live="polite"></div>
      </aside>

      <section id="empty" class="empty-state">
        <div class="empty-icon">✦</div>
        <h2>Escolha um conteúdo para revisar</h2>
        <p>Abra um item da fila para ler o artigo, conferir suas evidências e tomar uma decisão.</p>
      </section>

      <section id="editor" class="workspace" hidden>
        <div class="workspace-head">
          <div>
            <div class="meta-line"><span id="tenant-label" class="tenant-pill"></span><span id="post-id"></span></div>
            <h2 id="editor-heading">Revisar conteúdo</h2>
            <p id="post-excerpt" class="workspace-excerpt"></p>
          </div>
          <span id="save-state" class="save-state"></span>
        </div>

        <nav class="tabs" aria-label="Modos de revisão">
          <button class="tab active" data-panel="reading-panel">Leitura</button>
          <button class="tab" data-panel="evidence-panel">Evidências e qualidade</button>
          <button class="tab" data-panel="edit-panel">Editar conteúdo</button>
          <button class="tab" data-panel="history-panel">Histórico</button>
        </nav>

        <div id="reading-panel" class="panel reading-panel">
          <div class="article-cover"><img id="hero-image" alt="Imagem editorial do artigo" /></div>
          <div class="article-shell">
            <div id="preview-state" class="preview-state" role="status">Preparando a leitura…</div>
            <iframe id="preview" class="preview" sandbox="" title="Prévia segura do artigo"></iframe>
            <details id="preview-fallback" class="preview-fallback" hidden>
              <summary>A prévia não apareceu? Ler o texto sem formatação</summary>
              <pre id="preview-plain"></pre>
            </details>
          </div>
        </div>

        <div id="evidence-panel" class="panel" hidden>
          <div class="section-heading"><div><span class="eyebrow">Auditoria</span><h3>O que sustenta este conteúdo</h3></div><p>Revise os gates automáticos e abra as fontes originais antes de aprovar.</p></div>
          <div id="monetization" class="monetization"></div>
          <div id="quality-evidence" class="quality-evidence"></div>
        </div>

        <div id="edit-panel" class="panel" hidden>
          <div class="section-heading"><div><span class="eyebrow">Modo de edição</span><h3>Ajustes editoriais</h3></div><p>Salve as alterações antes de publicar.</p></div>
          <form id="edit-form">
            <div class="form-grid">
              <label class="full">Título<input name="title" required maxlength="500" /></label>
              <label>Categoria<input name="category_slug" placeholder="slug-da-categoria" /></label>
              <label>ASIN do produto<input name="product_asin" placeholder="Opcional" /></label>
              <label class="full">Resumo<textarea name="excerpt" rows="3"></textarea></label>
              <label class="full">Conteúdo Markdown<textarea name="content" rows="24" required></textarea></label>
              <label class="full">URL da imagem<input name="image_url" /></label>
              <label>Nota<input name="rating" type="number" min="0" max="5" step="0.1" /></label>
              <label>Tags<input name="tags" placeholder="tag 1, tag 2" /></label>
              <label class="full">Título SEO<input name="seo_title" maxlength="500" /></label>
              <label class="full">Descrição SEO<textarea name="seo_description" rows="3"></textarea></label>
              <label>Prós<input name="pros" placeholder="Item 1, item 2" /></label>
              <label>Contras<input name="cons" placeholder="Item 1, item 2" /></label>
            </div>
            <div class="form-actions"><button type="submit" class="secondary">Salvar alterações</button></div>
          </form>
        </div>

        <div id="history-panel" class="panel" hidden>
          <div class="section-heading"><div><span class="eyebrow">Rastreabilidade</span><h3>Histórico editorial</h3></div></div>
          <div id="history" class="history"></div>
        </div>

        <div id="decision-panel" class="decision-bar">
          <div class="decision-copy"><strong>Decisão editorial</strong><span>Revise o conteúdo e registre o responsável.</span></div>
          <label>Responsável<input id="reviewer" value="editor" maxlength="100" /></label>
          <label class="decision-note">Nota da decisão<textarea id="decision-note" rows="1" placeholder="Motivo ou orientação editorial"></textarea></label>
          <div class="decision-actions">
            <button id="reject" class="danger">Rejeitar</button>
            <button id="approve" class="primary">Aprovar e publicar</button>
          </div>
        </div>
      </section>
    </main>

    <div id="toast" role="status" aria-live="polite"></div>

    <script>
      import { marked } from 'marked';

      const list = document.querySelector<HTMLDivElement>('#post-list')!;
      const count = document.querySelector<HTMLElement>('#count')!;
      const editor = document.querySelector<HTMLElement>('#editor')!;
      const empty = document.querySelector<HTMLElement>('#empty')!;
      const form = document.querySelector<HTMLFormElement>('#edit-form')!;
      const preview = document.querySelector<HTMLIFrameElement>('#preview')!;
      const previewState = document.querySelector<HTMLElement>('#preview-state')!;
      const previewFallback = document.querySelector<HTMLDetailsElement>('#preview-fallback')!;
      const previewPlain = document.querySelector<HTMLElement>('#preview-plain')!;
      const heroImage = document.querySelector<HTMLImageElement>('#hero-image')!;
      const history = document.querySelector<HTMLElement>('#history')!;
      const qualityEvidence = document.querySelector<HTMLElement>('#quality-evidence')!;
      const monetization = document.querySelector<HTMLElement>('#monetization')!;
      const toast = document.querySelector<HTMLElement>('#toast')!;
      const statusFilter = document.querySelector<HTMLSelectElement>('#status')!;
      const tenantFilter = document.querySelector<HTMLSelectElement>('#tenant')!;
      const decisionPanel = document.querySelector<HTMLElement>('#decision-panel')!;
      let selectedId: number | null = null;
      let openRequest = 0;
      let previewTimer: number | null = null;

      const fields = ['title', 'excerpt', 'content', 'image_url', 'category_slug', 'product_asin', 'rating', 'seo_title', 'seo_description'];

      function notify(message: string, error = false) {
        toast.textContent = message;
        toast.className = error ? 'show error' : 'show';
        window.setTimeout(() => toast.className = '', 3500);
      }

      async function api(path: string, init?: RequestInit) {
        const response = await fetch(`/api/editorial/${path}`, { ...init, headers: { 'Content-Type': 'application/json', ...(init?.headers || {}) } });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.detail || 'Falha na operação');
        return body;
      }

      function splitList(value: FormDataEntryValue | null) {
        return String(value || '').split(',').map(item => item.trim()).filter(Boolean);
      }

      function escapeHtml(value: unknown) {
        return String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
      }

      function showPanel(id: string) {
        document.querySelectorAll<HTMLElement>('.panel').forEach(panel => panel.hidden = panel.id !== id);
        document.querySelectorAll<HTMLButtonElement>('.tab').forEach(tab => tab.classList.toggle('active', tab.dataset.panel === id));
      }

      function resolveImageUrl(imageUrl: string | null, tenantSlug: string) {
        if (!imageUrl) return '';
        if (/^https?:\/\//i.test(imageUrl)) return imageUrl;
        return new URL(imageUrl, 'https://api.expansao-ai.com.br').toString();
      }

      function renderPreview() {
        const content = form.elements.namedItem('content') as HTMLTextAreaElement;
        const source = content.value || '';
        const rendered = marked.parse(escapeHtml(source)) as string;
        const documentHtml = `<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'"><style>:root{color:#26332b;font-family:Georgia,serif}body{max-width:760px;margin:0 auto;padding:42px 46px 70px;font-size:18px;line-height:1.82}h2{margin:2.2em 0 .65em;color:#14281d;font-size:1.6em;line-height:1.2}h3{margin-top:1.8em;color:#1c3828}p{margin:0 0 1.2em}ul,ol{padding-left:1.3em}blockquote{margin:1.5em 0;padding-left:1.2em;border-left:3px solid #b98a47;color:#536057}strong{color:#14281d}@media(max-width:600px){body{padding:24px;font-size:16px}}</style></head><body>${rendered || '<p>Este conteúdo está vazio.</p>'}</body></html>`;
        if (previewTimer !== null) window.clearTimeout(previewTimer);
        previewState.textContent = 'Preparando a leitura…';
        previewState.hidden = false;
        preview.hidden = true;
        previewFallback.hidden = false;
        previewFallback.open = false;
        previewPlain.textContent = source || 'Este conteúdo está vazio.';
        preview.onload = () => {
          if (preview.srcdoc !== documentHtml) return;
          previewState.hidden = true;
          preview.hidden = false;
          if (previewTimer !== null) window.clearTimeout(previewTimer);
        };
        preview.removeAttribute('srcdoc');
        window.requestAnimationFrame(() => { preview.srcdoc = documentHtml; });
        previewTimer = window.setTimeout(() => {
          if (!preview.hidden) return;
          previewState.textContent = 'A prévia formatada demorou para carregar. Use o texto sem formatação abaixo.';
          previewFallback.open = true;
        }, 2500);
      }

      function renderMonetization(post: any) {
        const hasAffiliate = Boolean(post.product_asin && post.affiliate_url);
        if (!hasAffiliate) {
          monetization.innerHTML = `<div class="monetization-card inactive"><span>Sem link afiliado</span><div><strong>Nenhum produto está associado a este conteúdo.</strong><p>Não haverá botão de compra no artigo publicado. Associe e valide um ASIN somente quando o produto exato estiver confirmado.</p></div></div>`;
          return;
        }
        let tagValid = false;
        try { tagValid = new URL(post.affiliate_url).searchParams.get('tag') === 'marcosmrego-20'; } catch {}
        monetization.innerHTML = `<div class="monetization-card active"><span>Link afiliado ativo</span><div><strong>${escapeHtml(post.product_title || 'Produto associado')}</strong><p>ASIN: <code>${escapeHtml(post.product_asin)}</code> · Tag: ${tagValid ? 'validada' : 'verificar'}</p><a href="${escapeHtml(post.affiliate_url)}" target="_blank" rel="noopener noreferrer nofollow sponsored">Abrir URL final da Amazon ↗</a></div></div>`;
      }

      async function loadPosts() {
        list.innerHTML = '<p class="loading">Carregando conteúdos…</p>';
        const query = new URLSearchParams({ status: statusFilter.value, page_size: '100' });
        if (tenantFilter.value) query.set('tenant_slug', tenantFilter.value);
        try {
          const data = await api(`posts?${query}`);
          count.textContent = `${data.total} ${data.total === 1 ? 'conteúdo' : 'conteúdos'}`;
          list.innerHTML = '';
          if (!data.items.length) {
            list.innerHTML = '<div class="queue-empty">Tudo limpo por aqui.</div>';
            selectedId = null; editor.hidden = true; empty.hidden = false; return;
          }
          for (const post of data.items) {
            const button = document.createElement('button');
            button.className = `post-item${post.id === selectedId ? ' active' : ''}`;
            button.innerHTML = `<div class="item-meta"><span>${escapeHtml(post.tenant_name)}</span><small>#${post.id}</small></div><strong></strong><p>${escapeHtml(post.excerpt || 'Sem resumo editorial.')}</p><time>${new Date(post.updated_at || post.created_at).toLocaleString('pt-BR')}</time>`;
            button.querySelector('strong')!.textContent = post.title;
            button.addEventListener('click', () => openPost(post.id));
            list.append(button);
          }
        } catch (error) { list.innerHTML = '<p class="loading error-text">Não foi possível carregar a fila.</p>'; notify((error as Error).message, true); }
      }

      async function openPost(id: number) {
        const requestId = ++openRequest;
        try {
          const post = await api(`posts/${id}`);
          if (requestId !== openRequest) return;
          selectedId = id;
          document.querySelector('#tenant-label')!.textContent = post.tenant_name;
          document.querySelector('#post-id')!.textContent = `Draft #${post.id}`;
          document.querySelector('#editor-heading')!.textContent = post.title;
          document.querySelector('#post-excerpt')!.textContent = post.excerpt || '';
          for (const name of fields) {
            const input = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
            if (input) input.value = post[name] ?? '';
          }
          for (const name of ['tags', 'pros', 'cons']) (form.elements.namedItem(name) as HTMLInputElement).value = Array.isArray(post[name]) ? post[name].join(', ') : '';
          heroImage.src = resolveImageUrl(post.image_url, post.tenant_slug);
          heroImage.hidden = !post.image_url;
          decisionPanel.hidden = post.status !== 'draft';
          const gates = post.quality_gates || {};
          const sources = Array.isArray(post.source_evidence) ? post.source_evidence : [];
          renderMonetization(post);
          const gateItems = [
            [gates.sources_extracted, 'Duas fontes extraídas'],
            [!gates.primary_source_required || gates.primary_source_present, gates.primary_source_required ? 'Fonte primária presente' : 'Fonte primária não exigida'],
            [gates.similarity_valid, 'Pauta sem duplicidade'],
            [gates.structure_valid, `Estrutura: ${gates.word_count || '—'} palavras · ${gates.h2_count || '—'} seções`],
            [gates.image_webp_persisted, 'Imagem WebP persistida'],
            [gates.placeholders_absent, 'Sem placeholders'],
          ];
          qualityEvidence.innerHTML = `<div class="gate-grid">${gateItems.map(([ok, label]) => `<div class="gate ${ok ? 'pass' : 'warn'}"><span>${ok ? '✓' : '!'}</span><strong>${escapeHtml(label)}</strong></div>`).join('')}</div><div class="sources"><h4>Fontes consultadas <span>${sources.length}</span></h4>${sources.length ? sources.map((source: any, index: number) => `<article><div class="source-number">${index + 1}</div><div><span class="source-type">${escapeHtml(source.source_type)}</span><a href="${escapeHtml(source.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(source.title)}</a><small>Extraída em ${escapeHtml(source.extracted_at)}</small><ul>${(source.evidence || []).map((item: unknown) => `<li>${escapeHtml(item)}</li>`).join('')}</ul></div></article>`).join('') : '<p>Nenhuma evidência estruturada registrada.</p>'}</div>`;
          history.innerHTML = post.reviews?.length ? post.reviews.map((item: any) => `<div class="history-item"><span></span><div><strong>${escapeHtml(item.action)}</strong><p>${escapeHtml(item.reviewer)} · ${new Date(item.created_at).toLocaleString('pt-BR')}</p>${item.note ? `<blockquote>${escapeHtml(item.note)}</blockquote>` : ''}</div></div>`).join('') : '<div class="queue-empty">Nenhuma ação editorial registrada.</div>';
          renderPreview(); showPanel('reading-panel'); editor.hidden = false; empty.hidden = true; await loadPosts();
          if (requestId !== openRequest) return;
          document.querySelector('main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (error) { notify((error as Error).message, true); }
      }

      form.addEventListener('submit', async event => {
        event.preventDefault(); if (!selectedId) return;
        const data = new FormData(form); const payload: Record<string, unknown> = {};
        for (const name of fields) { const value = String(data.get(name) || '').trim(); payload[name] = name === 'rating' ? (value ? Number(value) : null) : (value || null); }
        payload.tags = splitList(data.get('tags')); payload.pros = splitList(data.get('pros')); payload.cons = splitList(data.get('cons'));
        try { await api(`posts/${selectedId}`, { method: 'PATCH', body: JSON.stringify(payload), headers: { 'X-Reviewer': document.querySelector<HTMLInputElement>('#reviewer')!.value } }); notify('Alterações salvas.'); await openPost(selectedId); }
        catch (error) { notify((error as Error).message, true); }
      });

      async function decide(decision: 'approve' | 'reject') {
        if (!selectedId) return;
        const verb = decision === 'approve' ? 'publicar' : 'rejeitar';
        if (!window.confirm(`Confirma que deseja ${verb} o draft #${selectedId}? Esta decisão ficará registrada.`)) return;
        try {
          await api(`posts/${selectedId}/decision`, { method: 'POST', body: JSON.stringify({ decision, reviewer: document.querySelector<HTMLInputElement>('#reviewer')!.value, note: document.querySelector<HTMLTextAreaElement>('#decision-note')!.value }) });
          notify(decision === 'approve' ? 'Conteúdo publicado.' : 'Conteúdo rejeitado.'); selectedId = null; editor.hidden = true; empty.hidden = false; await loadPosts();
        } catch (error) { notify((error as Error).message, true); }
      }

      document.querySelectorAll<HTMLButtonElement>('.tab').forEach(tab => tab.addEventListener('click', () => showPanel(tab.dataset.panel!)));
      form.elements.namedItem('content')!.addEventListener('input', renderPreview);
      document.querySelector('#approve')!.addEventListener('click', () => decide('approve'));
      document.querySelector('#reject')!.addEventListener('click', () => decide('reject'));
      document.querySelector('#refresh')!.addEventListener('click', loadPosts);
      statusFilter.addEventListener('change', loadPosts); tenantFilter.addEventListener('change', loadPosts);
      loadPosts();
    </script>
  </body>
</html>

<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #1d2922; background: #eef1ed; color-scheme: light; }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; }
  button, input, textarea, select { font: inherit; }
  button { cursor: pointer; }
  .topbar { min-height: 116px; display: grid; grid-template-columns: 250px 1fr auto; align-items: center; gap: 32px; padding: 22px 32px; color: #f9fcf8; background: #14271d; border-bottom: 3px solid #b98a47; }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-mark { width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid #d8b26f; border-radius: 12px; color: #f2d69e; font: 700 1.35rem Georgia, serif; }
  .brand div { display: grid; }
  .brand strong { font: 700 1.2rem Georgia, serif; }
  .brand span:last-child { color: #9fb1a6; font-size: .73rem; }
  .eyebrow { color: #9b7040; font-size: .68rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .topbar .eyebrow { color: #d8b26f; }
  h1 { margin: 4px 0 0; font: 600 2rem/1.05 Georgia, serif; }
  .filters { display: flex; gap: 10px; }
  label { display: grid; gap: 6px; color: #59645d; font-size: .74rem; font-weight: 750; }
  .filters label { color: #c8d2cc; }
  input, textarea, select { width: 100%; border: 1px solid #ccd3ce; border-radius: 9px; padding: 10px 11px; color: #1d2922; background: white; font-weight: 400; }
  select { min-width: 165px; }
  input:focus, textarea:focus, select:focus { outline: 3px solid #b98a4725; border-color: #a4773e; }
  textarea { resize: vertical; }
  main { min-height: calc(100vh - 116px); display: grid; grid-template-columns: 330px minmax(0, 1fr); gap: 20px; max-width: 1680px; margin: 0 auto; padding: 20px; }
  .queue, .workspace, .empty-state { border: 1px solid #dce1dc; border-radius: 14px; background: #fff; box-shadow: 0 8px 30px #1b2c2110; }
  .queue { position: sticky; top: 20px; height: calc(100vh - 156px); overflow: hidden; }
  .queue-head { min-height: 82px; display: flex; align-items: center; justify-content: space-between; padding: 18px; border-bottom: 1px solid #e6e9e6; }
  .queue-head div { display: grid; gap: 4px; }
  .queue-head strong { font-size: 1.15rem; }
  .icon-button { width: 38px; height: 38px; border: 1px solid #dde4df; border-radius: 9px; color: #42604d; background: #f6f8f6; font-size: 1.2rem; }
  .post-list { height: calc(100% - 82px); overflow: auto; }
  .post-item { width: 100%; display: grid; gap: 8px; padding: 17px 18px; text-align: left; border: 0; border-bottom: 1px solid #edf0ed; color: #101713; background: #fff; }
  .post-item, .post-item * { color: #000 !important; -webkit-text-fill-color: #000 !important; }
  .post-item:hover { background: #f7f9f7; }
  .post-item.active { background: #f4f7f3; box-shadow: inset 4px 0 #a4773e; }
  .item-meta { display: flex; justify-content: space-between; align-items: center; }
  .item-meta span { font-size: .66rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .item-meta small, .post-item time { font-size: .7rem; }
  .post-item strong { color: #101713; line-height: 1.3; }
  .post-item p { display: -webkit-box; overflow: hidden; margin: 0; color: #263129; font-size: .79rem; line-height: 1.45; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .loading, .queue-empty { padding: 28px 18px; color: #78817b; text-align: center; }
  .empty-state { display: grid; place-content: center; padding: 40px; text-align: center; }
  .empty-state > * { max-width: 440px; }
  .empty-icon { width: 56px; height: 56px; display: grid; place-items: center; margin: 0 auto 15px; border-radius: 50%; color: #956b38; background: #f5ead8; font-size: 1.5rem; }
  .empty-state h2 { margin: 0; font: 600 1.8rem Georgia, serif; }
  .empty-state p { color: #6c766f; line-height: 1.6; }
  .workspace { min-width: 0; overflow: clip; }
  .workspace-head { display: flex; justify-content: space-between; gap: 24px; padding: 28px 34px 22px; }
  .meta-line { display: flex; align-items: center; gap: 10px; color: #7b857f; font-size: .75rem; }
  .tenant-pill { padding: 5px 8px; border-radius: 999px; color: #315c41; background: #e5f0e8; font-weight: 800; text-transform: uppercase; }
  .workspace h2 { max-width: 940px; margin: 9px 0 8px; font: 600 clamp(1.65rem, 3vw, 2.45rem)/1.15 Georgia, serif; }
  .workspace-excerpt { max-width: 880px; margin: 0; color: #667169; line-height: 1.55; }
  .save-state { color: #668071; font-size: .78rem; }
  .tabs { display: flex; gap: 4px; padding: 0 30px; border-bottom: 1px solid #e2e6e2; }
  .tab { padding: 13px 15px; border: 0; border-bottom: 3px solid transparent; color: #657069; background: transparent; font-size: .83rem; font-weight: 750; }
  .tab:hover { color: #2d4938; }
  .tab.active { border-color: #a4773e; color: #1f3c2b; }
