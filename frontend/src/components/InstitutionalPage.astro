---
import { getTenantFromHost } from '../lib/tenant';
import { getSiteConfig } from '../lib/site';
import SeoHead from './SeoHead.astro';
import MonetizationHead from './MonetizationHead.astro';
import MonetizationBody from './MonetizationBody.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const config = getSiteConfig(getTenantFromHost(Astro.url.hostname));
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <SeoHead config={config} title={`${title} — ${config.name}`} description={description} path={path} />
  <MonetizationHead />
  <style define:vars={{ accent: config.accent }}>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #242433; background: #f5f6f8; line-height: 1.75; }
    .container { max-width: 820px; margin: 0 auto; padding: 0 1.2rem; }
    header { background: var(--accent); color: white; padding: 1rem 0; }
    header a { color: white; text-decoration: none; font-weight: 700; }
    main { background: white; margin: 2rem auto; padding: 2rem; border-radius: 12px; }
    h1 { margin-top: 0; line-height: 1.2; }
    h2 { margin-top: 1.8rem; line-height: 1.3; }
    a { color: var(--accent); }
  </style>
</head>
<body>
  <MonetizationBody />
  <header><div class="container"><a href="/">← {config.name}</a></div></header>
  <main class="container">
    <h1>{title}</h1>
    <slot />
  </main>
  <SiteFooter config={config} />
</body>
</html>

