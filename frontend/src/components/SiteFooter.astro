---
import type { SiteConfig } from '../lib/site';

interface Props { config: SiteConfig }
const { config } = Astro.props;
---

<footer>
  <div class="container">
    <p>{config.footer}</p>
    <nav aria-label="Institucional">
      <a href="/sobre">Sobre</a>
      <a href="/contato">Contato</a>
      <a href="/privacidade">Privacidade</a>
      <a href="/termos">Termos</a>
      <a href="/sitemap.xml">Sitemap</a>
    </nav>
  </div>
</footer>

<style>
  footer { text-align: center; padding: 2.5rem 0; color: #777; font-size: .85rem; border-top: 1px solid #eee; margin-top: 2rem; }
  footer p { margin: 0 0 .75rem; }
  footer nav { display: flex; justify-content: center; flex-wrap: wrap; gap: .85rem; }
  footer a { color: inherit; text-decoration: none; }
  footer a:hover { text-decoration: underline; }
</style>
